APP_NAME=Kelompok Sahabat Obor Mas
APP_ENV=local
APP_KEY=base64:Mgm2/7aO46G0wwQzQCdSryAvm8nPoiyQ4rLoCFiuprA=
APP_DEBUG=true
APP_URL=http://localhost
# Opsional: URL foto di export kunjungan (pendek). Kosongkan = pakai default di config/obormas.php
# PUBLIC_STORAGE_BASE=http://103.253.212.105/obormas/storage

# Persetujuan akun — HANYA untuk migrasi isi/perbaiki registration_reviewed_by di data LAMA.
# Approve/Tolak dari Web Admin tetap mencatat user yang LOGIN; env ini tidak mengubah itu.
# REGISTRATION_LEGACY_REVIEWER_EMAIL=email-admin-untuk-tebakan-backfill@...
# REGISTRATION_LEGACY_REVIEWER_REPLACE_FROM_EMAIL=email-admin-sumber-salah@...

# Scope anggota (default false = perilaku API seperti sebelumnya). Nyalakan setelah app siap.
# STRICT_MEMBER_KELOMPOK_SCOPE=true  → untuk role user: blok tambah/ubah/hapus/export master anggota + filter modul lain (mis. kel-sah). GET /anggota & detail master untuk user sudah selalu sekelompok (ID_KS dari no_agt) tanpa env ini.
# STRICT_MEMBER_NO_AGT_SAME_KELOMPOK=true

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=firebird
DB_USERNAME=root
DB_PASSWORD=Galih1522


# env database untuk macbook dengan mamp pro
# DB_HOST=127.0.0.1
# DB_PORT=8889
# DB_DATABASE=set nama databasenya
# DB_USERNAME=root
# DB_PASSWORD=root

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Gmail SMTP Configuration (for OTP emails)
# Uncomment and configure these settings when using Gmail SMTP
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=your_email@gmail.com
# MAIL_PASSWORD=your_app_password_16_digits
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="${MAIL_USERNAME}"

# OTP Configuration
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT=3

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Firebird (legacy .fdb) — dipakai FirebirdService / impor anggota & DATA_TRS
# FIREBIRD_HOST=127.0.0.1
# FIREBIRD_PORT=3050
# FIREBIRD_DATABASE=/path/ke/database.fdb
# FIREBIRD_USERNAME=SYSDBA
# FIREBIRD_PASSWORD=masterkey
# FIREBIRD_CHARSET=UTF8
# Nama tabel transaksi di Firebird (huruf besar, default DATA_TRS)
# FIREBIRD_DATA_TRS_TABLE=DATA_TRS

# Sanctum (for SPA - Web Admin typically runs on port 5173)
# SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,localhost:5173,127.0.0.1

# Super Admin (Web Admin)
SUPER_ADMIN_EMAIL=superadmin@obormas.com
SUPER_ADMIN_PASSWORD=SuperAdmin@123

# Admin default (Web Admin)
ADMIN_EMAIL=admin@obormas.com
ADMIN_PASSWORD=Admin@123
